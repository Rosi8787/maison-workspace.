{
  "info": {
    "name": "UKK Smart Coworking Space",
    "description": "Koleksi lengkap 43 endpoint API untuk sistem reservasi coworking space.\n\nCara pakai:\n1. Import file ini ke Postman\n2. Set variable `base_url` = http://localhost:3001\n3. Jalankan Login dulu, token otomatis tersimpan ke variable {{token}}\n4. Semua request yang butuh auth sudah pakai {{token}} di Authorization header",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3001", "type": "string" },
    { "key": "token", "value": "paste_jwt_token_disini", "type": "string" }
  ],
  "item": [

    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Register Member",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/register/member", "host": ["{{base_url}}"], "path": ["api","auth","register","member"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama_member\": \"Budi Santoso\",\n  \"instansi\": \"Universitas Teknologi\",\n  \"alamat\": \"Jl. Merdeka No. 10, Jakarta\",\n  \"telp\": \"081234567890\",\n  \"username\": \"budi_santoso\",\n  \"password\": \"password123\",\n  \"foto\": \"/uploads/members/foto.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Register Admin Space",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/register/admin-space", "host": ["{{base_url}}"], "path": ["api","auth","register","admin-space"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama_coworking\": \"CoSpace Jakarta\",\n  \"nama_pemilik\": \"Ahmad Fauzi\",\n  \"telp\": \"082112345678\",\n  \"alamat\": \"Jl. Sudirman No. 50, Jakarta Pusat\",\n  \"deskripsi\": \"Coworking space modern di pusat kota dengan fasilitas lengkap\",\n  \"username\": \"admin_cospace\",\n  \"password\": \"admin123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "  pm.collectionVariables.set('token', res.access_token);",
                  "  console.log('Token tersimpan otomatis ke variable {{token}}');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"budi_santoso\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Get Profile (JWT)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/auth/profile", "host": ["{{base_url}}"], "path": ["api","auth","profile"] }
          }
        }
      ]
    },

