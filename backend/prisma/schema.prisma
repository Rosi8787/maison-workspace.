// Prisma schema - UKK Smart Coworking Space Reservation System
// Provider: PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUM
// ==========================================

enum Role {
  MEMBER
  ADMIN
}

enum StatusReservasi {
  belum_dikonfirm
  disetujui
  aktif
  selesai
  dibatalkan
}

enum TipeSpace {
  Personal_Desk
  Private_Office
  Meeting_Room
}

// ==========================================
// MODEL USERS
// ==========================================

model users {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
  role     Role   @default(MEMBER)

  member      member?
  space_owner space_owner?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// MODEL MEMBER
// ==========================================

model member {
  id          Int     @id @default(autoincrement())
  nama_member String
  instansi    String
  alamat      String
  telp        String
  foto        String?
  id_user     Int     @unique

  user      users       @relation(fields: [id_user], references: [id], onDelete: Cascade)
  reservasi reservasi[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// MODEL SPACE OWNER (Admin)
// ==========================================

model space_owner {
  id             Int     @id @default(autoincrement())
  nama_coworking String
  nama_pemilik   String
  telp           String
  alamat         String
  deskripsi      String?
  id_user        Int     @unique

  user      users       @relation(fields: [id_user], references: [id], onDelete: Cascade)
  spaces    space[]
  reservasi reservasi[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// MODEL SPACE
// ==========================================

model space {
  id            Int       @id @default(autoincrement())
  nama_space    String
  tipe          TipeSpace
  kapasitas     Int
  harga_per_jam Decimal   @db.Decimal(12, 2)
  deskripsi     String?
  foto          String?
  id_owner      Int

  owner            space_owner        @relation(fields: [id_owner], references: [id], onDelete: Cascade)
  detail_reservasi detail_reservasi[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// MODEL DISKON
// ==========================================

model diskon {
  id                Int      @id @default(autoincrement())
  nama_diskon       String
  kode_diskon       String   @unique
  persentase_diskon Decimal  @db.Decimal(5, 2)
  tanggal_awal      DateTime @db.Date
  tanggal_akhir     DateTime @db.Date

  detail_reservasi detail_reservasi[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// MODEL RESERVASI
// ==========================================

model reservasi {
  id                Int             @id @default(autoincrement())
  kode_reservasi    String          @unique
  tanggal_reservasi DateTime        @db.Date
  // jam_mulai disimpan sebagai String "HH:MM" untuk portabilitas
  jam_mulai         String
  durasi_jam        Int
  status            StatusReservasi @default(belum_dikonfirm)
  id_member         Int
  id_owner          Int

  member           member             @relation(fields: [id_member], references: [id], onDelete: Restrict)
  owner            space_owner        @relation(fields: [id_owner], references: [id], onDelete: Restrict)
  detail_reservasi detail_reservasi[]

  checkin_at  DateTime?
  checkout_at DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// MODEL DETAIL RESERVASI
// ==========================================

model detail_reservasi {
  id           Int     @id @default(autoincrement())
  id_reservasi Int
  id_space     Int
  id_diskon    Int?
  total_harga  Decimal @db.Decimal(14, 2)

  reservasi reservasi @relation(fields: [id_reservasi], references: [id], onDelete: Cascade)
  space     space     @relation(fields: [id_space], references: [id], onDelete: Restrict)
  diskon    diskon?   @relation(fields: [id_diskon], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
